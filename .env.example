# =============================================================================
# Automated Code Review Agent — environment configuration
# Copy this file to .env and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub
# -----------------------------------------------------------------------------
# Personal access token used to fetch PR data and post review comments.
# Classic token: `repo` scope. Fine-grained token: read access to
# repository contents and read/write access to pull requests.
GITHUB_TOKEN=ghp_your_personal_access_token

# Shared secret for HMAC verification of inbound webhook requests.
# Configure the same value in the GitHub repository's webhook settings.
# When unset, every webhook is rejected (401) unless ALLOW_UNSIGNED_WEBHOOKS
# is set below.
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Local development only: accept unsigned webhooks when no secret is set.
# Never enable this on a publicly reachable deployment.
# ALLOW_UNSIGNED_WEBHOOKS=true


# -----------------------------------------------------------------------------
# Azure OpenAI
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key
# Optional; defaults to 2024-02-15-preview. Recorded in reports of live runs.
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# IMPORTANT — REPRODUCIBILITY:
# Pin the deployment names you ran experiments against and treat changes
# to these values as a methodology change. Evaluation results in
# `reports/` are not portable across model versions or embedding versions:
# updating a deployment name implicitly invalidates prior results. A
# deployment name does not pin the model version behind it; reports record
# the model names the API returns, so a silent upgrade shows up there.
# When you re-pin, re-run the full evaluation suite and note the change
# in EVALUATION.md's "Methodology change log".
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
